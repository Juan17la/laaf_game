#: scripts/ch2_scenes_b.gd:230
msgid "Tomás. Elena's brother."
msgstr ""

#: scripts/ch2_scenes_b.gd:251
msgid "OLD TOM"
msgstr ""

#: scripts/ch2_scenes_b.gd:252
msgid "Old Tom himself. Look at you."
msgstr ""

#: scripts/ch2_scenes_b.gd:254
msgid "Something's snagged on his jaw. A box."
